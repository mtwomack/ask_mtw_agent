# https://aistudio.google.com/app/apikey
AGENT_MODEL=gemini-3.5-flash-lite
SEARCH_MODEL=gemini-2.5-flash-lite
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_GENAI_USE_VERTEXAI=<GOOGLE_GENAI_USE_VERTEXAI>
GOOGLE_API_KEY=<GOOGLE_API_KEY>
ENV=local
DEV_USER_ID=<DEV_USER_ID>
DATABASE_URL=<DATABASE_URL>
TWELVEDATA_API_KEY=<TWELVEDATA_API_KEY>
FINNHUB_API_KEY=<FINNHUB_API_KEY>
TAVILY_API_KEY=<TAVILY_API_KEY>

# Sign-in (see auth.py). off = no sign-in, you're DEV_USER_ID. signin = Google sign-in screen.
AUTH_MODE=off
ADMIN_EMAILS=<your.email@gmail.com>
ALLOWED_EMAILS=
SESSION_SECRET=<python -c "import secrets; print(secrets.token_urlsafe(32))">
# Google Cloud Console > Google Auth Platform > Clients > Web application
# redirect URI: http://localhost:8000/auth/callback/google
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>

# Cloud Run only (deploy/deploy.py): the ponder_cloud login from deploy/cloud_schema.sql,
# so the cloud version uses its own "cloud" schema. Never the same as DATABASE_URL.
DATABASE_URL_CLOUD=<postgresql://ponder_cloud:...@...-pooler.../neondb?sslmode=require>
